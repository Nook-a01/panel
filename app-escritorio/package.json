{
  "name": "panel",
  "version": "1.4.0",
  "description": "Deportes, plata, campamento e Instagram en un solo lugar.",
  "main": "principal.js",
  "scripts": {
    "start": "electron .",
    "empaquetar": "electron-builder --win portable --x64"
  },
  "author": "Nook",
  "license": "MIT",
  "build": {
    "appId": "io.github.nooka01.panel-instagram",
    "productName": "Panel",
    "files": [
      "principal.js",
      "puente.js",
      "barra.html",
      "panel.js",
      "estudio-motor.js",
      "puente-estudio.js",
      "estudio.html",
      "estudio.js",
      "pieza-inicial.json",
      "icono.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Panel.exe"
    }
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^44.3.0"
  }
}
